# ---- ログイン ----
# ダッシュボードのログインパスワード（必須）
DASHBOARD_PASSWORD="change-me"
# セッション署名用のランダムな文字列（openssl rand -base64 32 などで生成）
DASHBOARD_SESSION_SECRET="replace-with-a-long-random-string"
# 公開URL（Slack通知のリンクに使用。例: https://revenue-dashboard.vercel.app）
DASHBOARD_URL=""

# ---- データソース ----
# 通常は Apps Script 方式（scripts/gas/webapp.gs をスプレッドシートにデプロイ）
# ウェブアプリURL（https://script.google.com/macros/s/…/exec）
GAS_WEBAPP_URL=""
# スクリプトの TOKEN に設定した合言葉
GAS_TOKEN=""
# gas / sheets / demo（未指定なら gas → sheets の順に接続情報がある方、なければ demo）
REVENUE_DATA_SOURCE=""

# （サービスアカウントの鍵が使える環境で Sheets API を使う場合のみ）
# スプレッドシートID（https://docs.google.com/spreadsheets/d/<ここ>/edit）
GOOGLE_SHEETS_SPREADSHEET_ID=""
# サービスアカウントのJSONキー（そのまま or Base64）
GOOGLE_SERVICE_ACCOUNT_JSON=""
# （JSONの代わりに）メールアドレスと秘密鍵を個別に指定してもよい。秘密鍵の改行は \n のままでよい
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# スプレッドシート読み込み結果のキャッシュ秒数
REVENUE_CACHE_TTL_SECONDS="60"

# ---- 通知（任意） ----
# /api/alerts の認証トークン（Vercel Cron の場合は CRON_SECRET でも可）
REVENUE_CRON_SECRET=""
# アラートを Slack に通知する場合の Incoming Webhook URL
SLACK_WEBHOOK_URL=""
