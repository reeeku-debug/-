# ---- ログイン ----
# ダッシュボードのログインパスワード（必須）
DASHBOARD_PASSWORD="change-me"
# セッション署名用のランダムな文字列（openssl rand -base64 32 などで生成）
DASHBOARD_SESSION_SECRET="replace-with-a-long-random-string"
# 公開URL（Slack通知のリンクに使用。例: https://revenue-dashboard.vercel.app）
DASHBOARD_URL=""

# ---- データソース ----
# sheets（Googleスプレッドシート）/ demo（ダミーデータ）
# 未指定の場合、下記の接続情報が揃っていれば sheets、なければ demo になる
REVENUE_DATA_SOURCE=""
# スプレッドシートID（https://docs.google.com/spreadsheets/d/<ここ>/edit）
GOOGLE_SHEETS_SPREADSHEET_ID=""
# サービスアカウントのJSONキー（そのまま or Base64）
GOOGLE_SERVICE_ACCOUNT_JSON=""
# （JSONの代わりに）メールアドレスと秘密鍵を個別に指定してもよい。秘密鍵の改行は \n のままでよい
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# スプレッドシート読み込み結果のキャッシュ秒数
REVENUE_CACHE_TTL_SECONDS="60"

# ---- 通知（任意） ----
# /api/alerts の認証トークン（Vercel Cron の場合は CRON_SECRET でも可）
REVENUE_CRON_SECRET=""
# アラートを Slack に通知する場合の Incoming Webhook URL
SLACK_WEBHOOK_URL=""
