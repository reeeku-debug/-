# Prisma / PostgreSQL
# ローカル開発: Docker等でPostgreSQLを起動し、下記のような接続文字列を指定してください
# 例: postgresql://postgres:postgres@localhost:5432/talent_app
# 本番(Vercel): Vercel Postgres / Neon / Supabase 等の接続文字列を設定してください
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talent_app"

# マイグレーション実行専用の直接接続（プール接続はアドバイザリーロックを
# サポートしないため）。ローカルではDATABASE_URLと同じ値でOK。
# Vercel+Neon連携時は自動で用意される DATABASE_URL_UNPOOLED を使う。
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/talent_app"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ---- 配信収益ダッシュボード（/admin/revenue）----
# データソース: sheets（Googleスプレッドシート）/ demo（ダミーデータ）
# 未指定の場合、下記の接続情報が揃っていれば sheets、なければ demo になる
REVENUE_DATA_SOURCE=""
# スプレッドシートID（https://docs.google.com/spreadsheets/d/<ここ>/edit）
GOOGLE_SHEETS_SPREADSHEET_ID=""
# サービスアカウント（スプレッドシートを「編集者」として共有しておく）
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# 秘密鍵。改行は \n のままでよい
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# （上2つの代わりに）JSONキーをそのまま or Base64 で指定してもよい
GOOGLE_SERVICE_ACCOUNT_JSON=""
# スプレッドシート読み込み結果のキャッシュ秒数
REVENUE_CACHE_TTL_SECONDS="60"
# /api/revenue/alerts の認証トークン（Vercel Cron の場合は CRON_SECRET でも可）
REVENUE_CRON_SECRET=""
# アラートを Slack に通知する場合の Incoming Webhook URL
SLACK_WEBHOOK_URL=""
