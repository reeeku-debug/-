# Prisma / PostgreSQL
# ローカル開発: Docker等でPostgreSQLを起動し、下記のような接続文字列を指定してください
# 例: postgresql://postgres:postgres@localhost:5432/vtuber_roadmap
# 本番(Vercel): Vercel Postgres / Neon / Supabase 等の接続文字列を設定してください
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vtuber_roadmap"

# マイグレーション実行専用の直接接続（プール接続はアドバイザリーロックを
# サポートしないため）。ローカルではDATABASE_URLと同じ値でOK。
# Vercel+Neon連携時は自動で用意される DATABASE_URL_UNPOOLED を使う。
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/vtuber_roadmap"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
