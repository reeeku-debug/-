# Prisma / PostgreSQL
# ローカル開発: Docker等でPostgreSQLを起動し、下記のような接続文字列を指定してください
# 例: postgresql://postgres:postgres@localhost:5432/talent_app
# 本番(Vercel): Vercel Postgres / Neon / Supabase 等の接続文字列を設定してください
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talent_app"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
