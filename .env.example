# SQLite (ローカル開発用。ファイルに保存されるのでブラウザを閉じても消えません)
DATABASE_URL="file:./dev.db"

# 本番でPostgreSQL(Supabase/Neon等)を使う場合の例:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# ※ その場合は prisma/schema.prisma の datasource provider を "postgresql" に変更してください。

# 管理画面ログインパスワード(本名などの個人情報を扱う画面を守るための共有パスワード)
ADMIN_PASSWORD="change-me-please"

# 管理セッションCookieの署名に使うランダムな文字列(32文字以上を推奨)
ADMIN_SESSION_SECRET="please-change-this-to-a-long-random-string"
